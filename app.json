{
  "expo": {
    "name": "Live Social",
    "slug": "live-social-app",
    "version": "0.5.0",
    "orientation": "portrait",
    "scheme": "livesocial",
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-av",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      "expo-asset"
    ],
    "android": {
      "package": "com.livesocial.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.example.livesocial",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Live Social to use your camera for live streaming.",
        "NSMicrophoneUsageDescription": "Allow Live Social to use your microphone for live streaming."
      },
      "bitcode": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6525d8ef-d258-4fbe-850a-cb9d64f0002f"
      }
    }
  }
}
